# ============================================
# In teeno ko copy karo .env.local me (local dev)
# aur Vercel ke Environment Variables me (deploy)
# ============================================

# 1) MongoDB Atlas connection string (FREE M0 cluster — README dekho)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/personaltracker?retryWrites=true&w=majority

# 2) Gemini API key — https://aistudio.google.com/apikey se FREE milti hai
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Gemini model — default gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 3) App ka PIN lock — website sirf isi PIN se khulegi (4-8 digit rakho)
APP_PIN=1234
